#!/usr/bin/env ruby
# Usage: bin/plan [--since REV] [--distros a,b] [--test] [gen/builds/SERIES.json ...]
#
# Prints the build targets as JSON: {"targets": [...], "origs": [...]}.
# A distro whose debian/ tag already exists on the source repository is left out.
require 'fileutils'
require 'json'
require 'open3'
require 'optparse'
require 'tmpdir'

ROOT = File.expand_path('..', __dir__)
BUILD_REPOSITORY = ENV.fetch('GITHUB_REPOSITORY', 'sorah-rbpkg/build')
COMMITTERS_KEYRING = File.join(ROOT, 'keys', 'committers.asc')
# Any other distro is taken to be an Ubuntu release.
DEBIAN_CODENAMES = %w[stretch buster bullseye bookworm trixie forky duke]

Series = Data.define(:file, :source, :repository, :master, :commit, :dist, :distros, :archs, :smoke, :large_runner, :test) do
  def self.load(path)
    config = JSON.parse(File.read(path))
    new(
      file: path,
      source: config.fetch('source'),
      repository: config.fetch('repository'),
      master: config.fetch('master'),
      commit: config.fetch('commit'),
      dist: config.fetch('dist'),
      distros: config.fetch('distros'),
      archs: config.fetch('archs'),
      smoke: config.fetch('smoke'),
      large_runner: config.fetch('large_runner'),
      test: config.fetch('test'),
    )
  end

  def url = "https://github.com/#{repository}.git"
  # Unique across series, unlike source: ruby-defaults has one series per default Ruby.
  def id = File.basename(file, '.json')
end

def git(*args, dir: nil)
  cmd = dir ? ['git', '-C', dir, *args] : ['git', *args]
  out, status = Open3.capture2(*cmd)
  raise "#{cmd.join(' ')} failed" unless status.success?
  out
end

def git?(*args, dir:)
  system('git', '-C', dir, *args, out: File::NULL, err: File::NULL)
end

def changed_series(since)
  # A push that creates the branch has no previous commit to compare with.
  return Dir[File.join(ROOT, 'gen/builds/*.json')] if since.nil? || since.match?(/\A0+\z/)

  git('diff', '--name-only', '--diff-filter=AM', since, 'HEAD', '--', 'gen/builds/*.json', dir: ROOT)
    .lines(chomp: true).select { build_requested?(since, it) }.map { File.join(ROOT, it) }
end

# Other fields change without asking for a build, which a test series would otherwise do for every distro.
BUILD_FIELDS = %w[commit try distros test]

def build_requested?(since, path)
  old, status = Open3.capture2('git', '-C', ROOT, 'show', "#{since}:#{path}", err: File::NULL)
  return true unless status.success?

  new = JSON.parse(File.read(File.join(ROOT, path)))
  JSON.parse(old).slice(*BUILD_FIELDS) != new.slice(*BUILD_FIELDS)
end

# Only commits and upstream tags signed by a key in keys/committers.asc may be built.
# kind is "commit" or "tag", for git verify-commit or verify-tag.
def verify_signature(kind, ref, dir:)
  Dir.mktmpdir('plan-gnupg') do |gnupghome|
    env = {'GNUPGHOME' => gnupghome}
    _, status = Open3.capture2e(env, 'gpg', '--batch', '--import', COMMITTERS_KEYRING)
    raise "cannot import #{COMMITTERS_KEYRING}" unless status.success?
    trusted = Open3.capture2(env, 'gpg', '--batch', '--with-colons', '--list-keys').first.scan(/^fpr:+(\h{40}):/).flatten

    _, raw, _ = Open3.capture3(env, 'git', '-C', dir, "verify-#{kind}", '--raw', ref)
    signer = raw[/^\[GNUPG:\] VALIDSIG .*?(\h{40})\s*$/, 1]
    raise "#{ref} is not signed by a key in #{File.basename(COMMITTERS_KEYRING)}" unless signer && trusted.include?(signer)
  end
end

# The build job's runs-on. The large ones are org-paid, 64 cores each, in the runner group that admits public repositories.
def runner_for(arch, large:)
  if large
    {group: 'build', labels: arch == 'arm64' ? 'ubuntu-24.04-arm64-large' : 'ubuntu-24.04-large'}
  else
    arch == 'arm64' ? 'ubuntu-24.04-arm' : 'ubuntu-24.04'
  end
end

# Same transform as sorah-debuild's debian/ tag naming (DEP-14).
def tag_for(version)
  "debian/#{version.gsub(/\.(?=\.|\z|lock\z)/, '.#').tr('~:', '_%')}"
end

def plan_series(series, distro_filter:, test:)
  raise "#{series.file}: dist must be dist or start with dist/" unless series.dist == 'dist' || series.dist.start_with?('dist/')
  raise "#{series.file}: commit must be a full SHA" unless series.commit.match?(/\A\h{40}\z/)

  dir = File.join(ROOT, 'tmp', 'plan', series.repository.tr('/', '_'))
  git('init', '-q', '--bare', dir) unless File.directory?(dir)
  git('fetch', '-q', '--filter=blob:none', '--no-tags', series.url, "+refs/heads/#{series.master}:refs/remotes/origin/#{series.master}", dir:)
  unless git?('merge-base', '--is-ancestor', series.commit, "refs/remotes/origin/#{series.master}", dir:)
    raise "#{series.file}: #{series.commit} is not on #{series.repository} #{series.master}"
  end
  verify_signature('commit', series.commit, dir:)

  head = git('cat-file', 'blob', "#{series.commit}:debian/changelog", dir:).lines.first
  m = head.match(/\A(?<source>\S+) \((?<version>[^)]+)\)/) or raise "#{series.file}: cannot parse changelog: #{head}"
  raise "#{series.file}: changelog source is #{m[:source]}, not #{series.source}" unless m[:source] == series.source
  raise "#{series.file}: changelog version #{m[:version]} has no ~dist" unless m[:version].include?('~dist')

  # A version without a Debian revision is a native package, which has no orig tarball.
  if m[:version].sub(/\A\d+:/, '').include?('-')
    upstream_version = m[:version].sub(/\A\d+:/, '').sub(/-[^-]+\z/, '')
    upstream_tag = "upstream/#{upstream_version.tr('~:', '_%')}"
    git('fetch', '-q', '--filter=blob:none', '--no-tags', '--force', series.url, "+refs/tags/#{upstream_tag}:refs/tags/#{upstream_tag}", dir:)
    verify_signature('tag', upstream_tag, dir:)
    # The orig is archived from this commit rather than the tag, which could be moved after planning.
    upstream_commit = git('rev-parse', "refs/tags/#{upstream_tag}^{commit}", dir:).strip
    orig_name = "#{series.source}_#{upstream_version}.orig.tar.gz"
  else
    upstream_version = upstream_tag = upstream_commit = orig_name = nil
  end
  existing_tags = git('ls-remote', '--tags', '--refs', series.url, 'refs/tags/debian/*')
    .lines(chomp: true).map { it.split("\t", 2).fetch(1).delete_prefix('refs/tags/') }
  existing_dists = git('ls-remote', '--heads', series.url, "refs/heads/#{series.dist}/*")
    .lines(chomp: true).map { it.split("\t", 2).fetch(1).delete_prefix('refs/heads/') }

  series.distros.filter_map do |distro|
    next if distro_filter && !distro_filter.include?(distro)
    # dockerfiles/<id>/ holds overrides for a single series.
    dockerfile = ["dockerfiles/#{series.id}/Dockerfile.#{distro}", "dockerfiles/Dockerfile.#{distro}"]
      .find { File.exist?(File.join(ROOT, it)) } or raise "#{series.file}: no dockerfiles/Dockerfile.#{distro}"

    deb_version = m[:version].sub('~dist', "~#{distro}")
    tag = tag_for(deb_version)
    if !test && existing_tags.include?(tag)
      warn "#{series.source} #{distro}: #{tag} exists, skipping"
      next
    end

    dist_branch = "#{series.dist}/#{distro}"
    # Everything a test run writes goes under test/<repo>/ of this repository instead of the source repository.
    prefix = test ? "test/#{series.repository.split('/').last}/" : ''
    {
      id: series.id,
      series_file: File.basename(series.file),
      source: series.source,
      repository: series.repository,
      master: series.master,
      commit: series.commit,
      distro:,
      dist_branch:,
      # The first release of a distro creates its dist branch at the series commit.
      new_dist: !existing_dists.include?(dist_branch),
      stage_branch: "#{prefix}dist-stage/#{series.id}/#{distro}",
      deb_version:,
      upstream_version:,
      tag:,
      archs: series.archs,
      runners: series.archs.to_h { [it, runner_for(it, large: series.large_runner)] },
      orig_name:,
      upstream_tag:,
      upstream_commit:,
      image: "#{DEBIAN_CODENAMES.include?(distro) ? 'debian' : 'ubuntu'}:#{distro}",
      dockerfile:,
      smoke: series.smoke,
      test:,
      release_repository: test ? BUILD_REPOSITORY : series.repository,
      release_dist_branch: "#{prefix}#{dist_branch}",
      release_tag: "#{prefix}#{tag}",
    }
  end
end

since = nil
distro_filter = nil
test = false
OptionParser.new do |o|
  o.on('--since REV') { since = it }
  o.on('--distros LIST') { distro_filter = it.split(',').map(&:strip).reject(&:empty?) }
  o.on('--test', 'Release into test/ of this repository, and rebuild released distros') { test = true }
end.parse!(ARGV)

files = ARGV.empty? ? changed_series(since) : ARGV.map { File.expand_path(it) }
targets = files.sort.flat_map do |file|
  series = Series.load(file)
  plan_series(series, distro_filter:, test: test || series.test)
end
origs = targets.select { it[:orig_name] }.map { it.slice(:repository, :source, :upstream_version, :upstream_tag, :upstream_commit, :orig_name) }.uniq

puts JSON.generate({targets:, origs:})
