#!/usr/bin/env ruby
# Usage: bin/publish [--dry-run] [--no-publish] [--test] [--repository OWNER/REPO] [--dockerfiles-dir DIR] [TAG ...]
#        bin/publish --relay-only [--dry-run] [--dockerfiles-dir DIR]
#
# Takes the draft releases that the build workflow left on the source repositories, verifies
# what CI produced, re-signs the tag and .changes with your GPG key, adds the packages to
# aptly, and publishes the release. Every phase is skipped when already done, so a run that
# failed halfway can simply be repeated. --dry-run only verifies, and changes nothing.
#
# Then it commits the newest released version of each series and distro to versions.json in a
# checkout of sorah-rbpkg/dockerfiles, ../dockerfiles by default, and pushes it.
require 'bundler/inline'
gemfile do
  source 'https://rubygems.org'
  gem 'aws-sdk-core'
  gem 'httpx'
end
require 'optparse'
require_relative '../lib/release'

Release = Data.define(:repository, :prefix, :tag, :dir, :git_dir, :changes_paths, :dsc_path, :files, :source, :version, :distro, :suite) do
  def url = "https://github.com/#{repository}.git"
  # A test release lives in this repository, under test/<repo>/ of its source repository.
  def source_repository = prefix.empty? ? repository : "#{repository.split('/').first}/#{prefix[%r{\Atest/([^/]+)/}, 1]}"
  # Several series may build one source package, as ruby-defaults does with one per default Ruby.
  def dist_branches
    SERIES.select { it.fetch('repository') == source_repository && it.fetch('source') == source }
      .map { "#{prefix}#{it.fetch('dist')}/#{distro}" }.uniq
  end
  def message = "#{source} Debian release #{version}"
  def changes_by_arch = changes_paths.to_h { [it[/_([a-z0-9]+)\.changes\z/, 1], File.read(it)] }
  def dsc = File.read(dsc_path)
  def signed_files = files.grep(/\.(changes|dsc|buildinfo)\z/)
  def aptly_files = files.grep(/\.(dsc|d?deb)\z/)
end

class Publisher
  def initialize(repositories:, prefix:, tags:, publish:, dry_run:, token:, relay:)
    @repositories = repositories
    @relay = relay
    @prefix = prefix
    @tags = tags
    @publish = publish
    @dry_run = dry_run
    @token = token
    @fingerprint = gpg_fingerprint
    @env = {'GH_TOKEN' => @token}
  end

  def run_all
    @relay&.check
    drafts = @repositories.flat_map do |repository|
      JSON.parse(capture(@env, 'gh', 'release', 'list', '--repo', repository, '--limit', '200', '--json', 'tagName,isDraft'))
        .select { it.fetch('isDraft') && it.fetch('tagName').match?(%r{\A#{@prefix}debian/}) }
        .map { [repository, it.fetch('tagName')] }
    end
    drafts.select! { @tags.include?(it.last) } unless @tags.empty?
    abort 'No draft releases to publish' if drafts.empty?
    drafts.sort!
    puts 'Drafts:', *drafts.map { |repository, tag| "  #{repository} #{tag}" }

    releases = {}
    each_parallel(drafts, DOWNLOAD_JOBS) { |repository, tag| releases[[repository, tag]] = download(repository, tag) }
    releases = drafts.map { releases.fetch(it) }
    releases.each { process(it) }
    return unless @publish

    publish(releases)
    @relay.sync
  end

  def process(release)
    tag = release.tag
    puts "=> #{tag}"
    draft = view(release)

    if draft.fetch('body').include?("#{RESIGNED_MARKER} #{@fingerprint}")
      puts ' * already re-signed, skipping verification'
    elsif @dry_run
      if signed?(release, draft)
        puts ' * would resume an interrupted re-sign'
      else
        verify(release)
        puts ' * would re-sign'
      end
      puts ' * would push the re-signed tag and files'
    else
      if signed?(release, draft)
        puts ' * resuming an interrupted re-sign'
        FileUtils.cp(Dir[File.join(signed_dir(release), '*')], release.dir)
      else
        verify(release)
        sign(release, draft)
      end
      push_signed(release)
    end
  end

  def view(release)
    JSON.parse(capture(@env, 'gh', 'release', 'view', release.tag, '--repo', release.repository, '--json', 'id,isDraft,body'))
  end

  # Kept until the release is published, so an interrupted push or upload can be repeated.
  def signed_dir(release) = File.join(ROOT, 'tmp', 'publish', "#{release.tag.tr('/', '_')}.signed")

  # The release ID ties the signed files to this draft, not an earlier one with the same tag.
  def signed?(release, draft)
    File.read(File.join(signed_dir(release), '.complete')) == draft.fetch('id')
  rescue Errno::ENOENT
    false
  end

  def download(repository, tag)
    # gitsign cannot resolve tags in a bare repository.
    work_dir = File.join(ROOT, 'tmp', 'publish', repository.tr('/', '_'))
    run('git', 'init', '-q', work_dir) unless File.directory?(work_dir)

    dir = File.join(ROOT, 'tmp', 'publish', tag.tr('/', '_'))
    FileUtils.mkdir_p(dir)
    view = JSON.parse(capture(@env, 'gh', 'release', 'view', tag, '--repo', repository, '--json', 'assets,body'))
    digests = view.fetch('assets').to_h { [it.fetch('name'), it.fetch('digest')] }
    # A rebuilt draft keeps the asset names, so a file is reused only if it matches the asset's digest.
    Dir.children(dir).each do |name|
      path = File.join(dir, name)
      if File.file?(path) && digests[asset_name(name)] == "sha256:#{Digest::SHA256.file(path).hexdigest}"
        File.rename(path, File.join(dir, asset_name(name)))
      else
        FileUtils.rm_rf(path)
      end
    end
    run(@env, 'gh', 'release', 'download', tag, '--repo', repository, '--dir', dir, '--skip-existing')
    restore_asset_names(dir)

    files = Dir[File.join(dir, '*')].sort
    changes_paths = files.grep(/\.changes\z/)
    dsc_paths = files.grep(/\.dsc\z/)
    raise "#{tag}: expected one .dsc, got #{dsc_paths.size}" unless dsc_paths.size == 1

    fields = parse_debian_metafile(File.read(changes_paths.first))
    distro = fields.fetch('Distribution').first
    suite = suite_line(view.fetch('body')) || distro
    raise "#{tag}: suite #{suite} is not #{distro} or #{distro}-proposed" unless [distro, "#{distro}-proposed"].include?(suite)
    Release.new(
      repository:, prefix: tag[%r{\A(.*?)debian/}, 1], tag:, dir:, git_dir: File.join(work_dir, '.git'), changes_paths:, dsc_path: dsc_paths.first, files:,
      source: fields.fetch('Source').first, version: fields.fetch('Version').first, distro:, suite:,
    )
  end

  def verify(release)
    puts ' * verifying what CI produced'
    git = ['git', '--git-dir', release.git_dir]
    dists = capture('git', 'ls-remote', '--heads', release.url, *release.dist_branches.map { "refs/heads/#{it}" })
      .lines(chomp: true).map { it.split("\t", 2).fetch(1).delete_prefix('refs/heads/') }
    raise "#{release.tag}: none of #{release.dist_branches.join(', ')} exists on #{release.repository}" if dists.empty?
    run(*git, 'fetch', '-q', '--filter=blob:none', '--no-tags', '--force', release.url,
      "refs/tags/#{release.tag}:refs/tags/#{release.tag}", *dists.map { "refs/heads/#{it}:refs/remotes/origin/#{it}" })
    run('gitsign', 'verify-tag',
      "--certificate-identity=https://github.com/#{signer_workflow('_distro.yml')}@refs/heads/main",
      "--certificate-oidc-issuer=#{OIDC_ISSUER}", release.tag, chdir: File.dirname(release.git_dir))
    on_dist = dists.any? do |dist|
      system(*git, 'merge-base', '--is-ancestor', "#{release.tag}^{commit}", "refs/remotes/origin/#{dist}")
    end
    raise "#{release.tag} is on none of #{dists.join(', ')}" unless on_dist

    each_parallel(release.files, ATTESTATION_JOBS) do |file|
      workflow = file.end_with?('.orig.tar.gz') ? 'build.yml' : '_distro.yml'
      ok = system(@env, 'gh', 'attestation', 'verify', file, '--repo', BUILD_REPOSITORY,
        '--signer-workflow', signer_workflow(workflow), '--source-ref', 'refs/heads/main', out: File::NULL)
      raise "#{File.basename(file)}: attestation verification failed" unless ok
      puts "  attested: #{File.basename(file)}"
    end

    [*release.changes_paths, release.dsc_path].each do |meta|
      parse_debian_metafile(File.read(meta)).fetch('Checksums-Sha256').each do |line|
        sha256, _size, name = line.split
        actual = Digest::SHA256.file(File.join(release.dir, name)).hexdigest
        raise "#{name}: sha256 #{actual} does not match #{File.basename(meta)}" unless actual == sha256
      end
    end
  end

  def sign(release, draft)
    puts " * re-signing with #{@fingerprint}"
    git = ['git', '--git-dir', release.git_dir]
    commit = capture(*git, 'rev-parse', "#{release.tag}^{commit}").strip
    run(*git, '-c', 'gpg.format=openpgp', 'tag', '-s', '-f', '-m', release.message, release.tag, commit)
    # sorah-debsign may run debsign in a container that only sees the working directory.
    run('sorah-debsign', *release.changes_paths.map { File.basename(it) }, chdir: release.dir)

    dir = signed_dir(release)
    FileUtils.rm_rf(dir)
    FileUtils.mkdir_p(dir)
    FileUtils.cp(release.signed_files, dir)
    File.write(File.join(dir, '.complete'), draft.fetch('id'))
  end

  # Repeatable: the tag is force-pushed and the files replaced, both with what sign produced.
  def push_signed(release)
    puts ' * pushing the re-signed tag and files'
    draft = view(release)
    raise "#{release.tag} is no longer a draft" unless draft.fetch('isDraft')
    attestations = attestation_section(draft.fetch('body'))

    git = ['git', '--git-dir', release.git_dir]
    puts "  $ git push --force #{release.url} refs/tags/#{release.tag}"
    auth = "http.https://github.com/.extraheader=AUTHORIZATION: basic #{["x-access-token:#{@token}"].pack('m0')}"
    system(*git, '-c', auth, 'push', '--force', release.url, "refs/tags/#{release.tag}", exception: true)
    # Uploaded under the names GitHub gave them, so --clobber finds the assets to replace.
    upload_dir = File.join(release.dir, '.upload')
    FileUtils.mkdir_p(upload_dir)
    uploads = release.signed_files.map do |file|
      File.join(upload_dir, asset_name(file)).tap { FileUtils.cp(file, it) }
    end
    run(@env, 'gh', 'release', 'upload', release.tag, '--repo', release.repository, '--clobber', *uploads)

    notes = File.join(release.dir, '.notes')
    File.write(notes, release_body(changes_by_arch: release.changes_by_arch, dsc: release.dsc, suite: release.suite, attestations:, resigned_by: @fingerprint))
    run(@env, 'gh', 'release', 'edit', release.tag, '--repo', release.repository, '--notes-file', notes)
  end

  # Releases leave draft only after every suite is published, as that makes their assets immutable.
  # A proposed one stays a pre-release until bin/promote.
  def publish(releases)
    puts '=> publishing'
    suites = releases.map(&:suite).uniq
    if @dry_run
      releases.each { puts " * would add #{it.tag} to #{APTLY_REPO_PREFIX}-#{it.suite}" }
      suites.each { puts " * would publish #{it}" }
      suites.flat_map { index_urls(it) }.each { puts " * would purge #{it}" }
      releases.each { puts " * would release #{it.tag}" }
      return
    end

    releases.each do |release|
      check_signed(release)
      run('aptly', 'repo', 'add', "#{APTLY_REPO_PREFIX}-#{release.suite}", *release.aptly_files)
    end
    suites.each do |suite|
      run('aptly', 'publish', 'update', "-gpg-key=#{APTLY_GPG_KEY}", suite, APTLY_ENDPOINT)
    end
    purge(suites.flat_map { index_urls(it) })
    releases.each do |release|
      run(@env, 'gh', 'release', 'edit', release.tag, '--repo', release.repository, '--draft=false')
    end
  end

  def check_signed(release)
    run('git', '--git-dir', release.git_dir, 'fetch', '-q', '--filter=blob:none', '--no-tags', '--force', release.url,
      "refs/tags/#{release.tag}:refs/tags/#{release.tag}")
    _, status_output, _ = Open3.capture3('git', '--git-dir', release.git_dir, 'verify-tag', '--raw', release.tag)
    raise "#{release.tag} is not signed by #{@fingerprint}" unless valid_signers(status_output).include?(@fingerprint)

    release.signed_files.each do |file|
      _, status_output, _ = Open3.capture3('gpg', '--status-fd', '2', '--verify', file)
      raise "#{File.basename(file)} is not signed by #{@fingerprint}" unless valid_signers(status_output).include?(@fingerprint)
    end
  end
end

publish = true
dry_run = false
relay_only = false
dockerfiles_dir = File.expand_path('../dockerfiles', ROOT)
repository = nil
prefix = ''
test = false
OptionParser.new do |o|
  o.on('-n', '--dry-run', 'Only verify, without signing, pushing or publishing') { dry_run = true }
  o.on('--no-publish', 'Stop after re-signing') { publish = false }
  o.on('--repository OWNER/REPO', 'Only this source repository, rather than every one under builds/') { repository = it }
  o.on('--dockerfiles-dir DIR', 'Local checkout of sorah-rbpkg/dockerfiles') { dockerfiles_dir = File.expand_path(it) }
  o.on('--relay-only', 'Only relay released versions to sorah-rbpkg/dockerfiles') { relay_only = true }
  o.on('--test', 'Work on the test/ releases of a test run, and never publish') do
    repository = BUILD_REPOSITORY
    # A test run writes under test/<repo>/.
    prefix = 'test/[^/]+/'
    publish = false
    test = true
  end
end.parse!(ARGV)

# Runs share tmp/publish, and each prunes a draft's directory before downloading into it.
FileUtils.mkdir_p(File.join(ROOT, 'tmp', 'publish'))
lock = File.open(File.join(ROOT, 'tmp', 'publish', '.lock'), File::RDWR | File::CREAT)
abort 'another bin/publish is running' unless lock.flock(File::LOCK_EX | File::LOCK_NB)

# The DebReleaser token cannot see this repository's drafts, so a test uses your own gh login.
token = test ? ENV['GH_TOKEN'] || capture('gh', 'auth', 'token').strip : github_token
relay = DockerfilesRelay.new(dir: dockerfiles_dir, token:, dry_run:) if publish
if relay_only
  abort '--relay-only cannot be combined with --test or --no-publish' unless relay
  relay.check
  relay.sync
else
  repositories = repository ? [repository] : SERIES.map { it.fetch('repository') }.uniq.sort
  Publisher.new(repositories:, prefix:, tags: ARGV, publish:, dry_run:, token:, relay:).run_all
end
