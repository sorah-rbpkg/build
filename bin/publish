#!/usr/bin/env ruby
# Usage: bin/publish [--dry-run] [--no-publish] [--test] [--repository OWNER/REPO] [--dockerfiles-dir DIR] [TAG ...]
#        bin/publish --relay-only [--dry-run] [--dockerfiles-dir DIR]
#
# Takes the draft releases that the build workflow left on the source repository, verifies
# what CI produced, re-signs the tag and .changes with your GPG key, adds the packages to
# aptly, and publishes the release. Every phase is skipped when already done, so a run that
# failed halfway can simply be repeated. --dry-run only verifies, and changes nothing.
#
# Then it commits the newest released version of each series and distro to versions.json in a
# checkout of sorah-rbpkg/dockerfiles, ../dockerfiles by default, and pushes it.
require 'bundler/inline'
gemfile do
  source 'https://rubygems.org'
  gem 'aws-sdk-core'
  gem 'httpx'
end
require 'digest'
require 'fileutils'
require 'json'
require 'open3'
require 'optparse'
require 'pathname'
require 'aws-sdk-core'
require 'httpx'

ROOT = File.expand_path('..', __dir__)
BUILD_REPOSITORY = 'sorah-rbpkg/build'
OIDC_ISSUER = 'https://token.actions.githubusercontent.com'
APTLY_REPO_PREFIX = 'sorah-ruby'
APTLY_ENDPOINT = 's3:sorah-ruby:'
APTLY_GPG_KEY = '805E57E2327EE86EB8180E0669CEB9D53F0F56A8'
APT_URL = 'https://cache.ruby-lang.org/lab/sorah/deb'
STSCAT_CONFIG = File.expand_path('~/.nkmi-deb-release.json')
# Must stay in sync with .github/scripts/draft-release.js.
RESIGNED_MARKER = '<!-- resigned-by:'
# gh attestation verify takes a few seconds per file, mostly waiting on the network.
ATTESTATION_JOBS = 8
# gh release download already fetches the assets of one release in parallel.
DOWNLOAD_JOBS = 4

def signer_workflow(name) = "#{BUILD_REPOSITORY}/.github/workflows/#{name}"

def index_urls(distro)
  files = %w[InRelease Release Release.gpg]
  %w[binary-amd64 binary-arm64].each { |dir| files.push(*%w[Packages Packages.gz Packages.bz2 Release].map { "main/#{dir}/#{it}" }) }
  files.push(*%w[Sources Sources.gz Sources.bz2 Release].map { "main/source/#{it}" })
  files.map { "#{APT_URL}/dists/#{distro}/#{it}" }
end

# Leaves out the environment hash, which carries GH_TOKEN.
def display_cmd(cmd) = cmd.grep_v(Hash).join(' ')

def run(*cmd, **opts)
  dir = "#{Pathname(opts[:chdir]).relative_path_from(Dir.pwd)} " if opts[:chdir]
  puts "  #{dir}$ #{display_cmd(cmd)}"
  system(*cmd, exception: true, **opts)
end

def capture(*cmd, **opts)
  out, status = Open3.capture2(*cmd, **opts)
  raise "#{display_cmd(cmd)} failed" unless status.success?
  out
end

# Runs the block for each item on that many threads, raising the first error once all have stopped.
def each_parallel(items, jobs)
  queue = Queue.new
  items.each { queue << it }
  queue.close
  workers = Array.new(jobs) do
    Thread.new do
      Thread.current.report_on_exception = false
      while (item = queue.pop)
        yield item
      end
    end
  end
  workers.each(&:join)
end

def parse_debian_metafile(str)
  raw = str[/-----BEGIN PGP SIGNED MESSAGE-----\n.+?\n\n(.+)-----BEGIN PGP SIGNATURE-----/m, 1] || str
  raw.each_line(chomp: true).reject(&:empty?).slice_before { it[0] != ' ' }.to_h do |lines|
    key, val = lines.first.split(':', 2)
    [key, [val&.strip, *lines.drop(1).map(&:strip)].reject { it.nil? || it.empty? }]
  end
end

def release_body(changes_by_arch:, dsc:, attestations: nil, resigned_by: nil)
  body = []
  body.push(attestations, '') if attestations
  body.push('### Changes', '')
  changes_by_arch.sort.each do |arch, content|
    body.push("#### #{arch}", '', '```', content.chomp, '```', '')
  end
  body.push('### dsc', '', '```', dsc.chomp, '```')
  body.push('', "#{RESIGNED_MARKER} #{resigned_by} -->") if resigned_by
  body.join("\n")
end

# The section draft-release.js writes, carried over when the body is rewritten.
# Older drafts carry it at the end rather than the top.
def attestation_section(body) = body[/^### Attestations\n.*?(?=\n\n###|\n\n<!--|\z)/m]&.rstrip

def github_token
  return ENV['GH_TOKEN'] if ENV['GH_TOKEN']

  config = JSON.parse(File.read(STSCAT_CONFIG))
  id_token = Aws::STS::Client.new.get_web_identity_token(
    audience: [config.fetch('stscat_audience')],
    signing_algorithm: 'ES384',
    duration_seconds: 300,
  ).web_identity_token
  resp = HTTPX.post(
    "#{config.fetch('stscat_url')}/token",
    json: {scope: 'sorah-rbpkg', identity: config.fetch('stscat_identity', 'release')},
    headers: {'authorization' => "Bearer #{id_token}", 'user-agent' => 'sorah-rbpkg-build-publish'},
  )
  resp.raise_for_status
  resp.json.fetch('token')
end

def gpg_fingerprint
  out = capture('gpg', '--with-colons', '--list-secret-keys', *ENV['GPGUSER'])
  # A capital S marks a key that can still sign, which leaves out revoked and expired ones.
  out[/^sec:(?:[^:]*:){10}[^:]*S[^:]*:.*\n(?:(?!sec:).*\n)*?fpr:+(\h{40}):/, 1] or raise 'no usable GPG signing key found'
end

# Primary key fingerprints that made a good signature, from gpg's VALIDSIG status lines.
def valid_signers(status_output)
  status_output.scan(/^\[GNUPG:\] VALIDSIG .*?(\h{40})\s*$/).flatten
end

# GitHub replaces characters such as "~" in release asset names with ".".
def asset_name(file) = File.basename(file).gsub(/[^A-Za-z0-9._+-]/, '.')

# Gives downloaded assets back the names that the .changes and .dsc files refer to them by.
def restore_asset_names(dir)
  names = Dir[File.join(dir, '*.{changes,dsc}')].flat_map do |meta|
    parse_debian_metafile(File.read(meta)).fetch('Files').map { it.split.last }
  end
  names.uniq.each do |name|
    downloaded = File.join(dir, asset_name(name))
    File.rename(downloaded, File.join(dir, name)) if name != asset_name(name) && File.exist?(downloaded)
  end
end

Release = Data.define(:repository, :prefix, :tag, :dir, :git_dir, :changes_paths, :dsc_path, :files, :source, :version, :distro) do
  def dist_branch = "#{prefix}dist/#{source.delete_prefix('ruby')}/#{distro}"
  def message = "#{source} Debian release #{version}"
  def changes_by_arch = changes_paths.to_h { [it[/_([a-z0-9]+)\.changes\z/, 1], File.read(it)] }
  def dsc = File.read(dsc_path)
  def signed_files = files.grep(/\.(changes|dsc|buildinfo)\z/)
  def aptly_files = files.grep(/\.(dsc|d?deb)\z/)
end

class Publisher
  def initialize(repository:, prefix:, tags:, publish:, dry_run:, token:, relay:)
    @repository = repository
    @relay = relay
    @prefix = prefix
    @tags = tags
    @publish = publish
    @dry_run = dry_run
    @token = token
    @fingerprint = gpg_fingerprint
    @env = {'GH_TOKEN' => @token}
    @url = "https://github.com/#{repository}.git"
  end

  def run_all
    @relay&.check
    drafts = JSON.parse(capture(@env, 'gh', 'release', 'list', '--repo', @repository, '--limit', '200', '--json', 'tagName,isDraft'))
      .select { it.fetch('isDraft') && it.fetch('tagName').start_with?("#{@prefix}debian/") }
      .map { it.fetch('tagName') }
    drafts &= @tags unless @tags.empty?
    abort 'No draft releases to publish' if drafts.empty?
    drafts.sort!
    puts 'Drafts:', *drafts.map { "  #{it}" }

    # gitsign cannot resolve tags in a bare repository.
    work_dir = File.join(ROOT, 'tmp', 'publish', @repository.tr('/', '_'))
    run('git', 'init', '-q', work_dir) unless File.directory?(work_dir)
    @git_dir = File.join(work_dir, '.git')

    releases = {}
    each_parallel(drafts, DOWNLOAD_JOBS) { releases[it] = download(it) }
    releases = drafts.map { releases.fetch(it) }
    releases.each { process(it) }
    return unless @publish

    publish(releases)
    @relay.sync
  end

  def process(release)
    tag = release.tag
    puts "=> #{tag}"
    draft = view(tag)

    if draft.fetch('body').include?("#{RESIGNED_MARKER} #{@fingerprint}")
      puts ' * already re-signed, skipping verification'
    elsif @dry_run
      if signed?(release, draft)
        puts ' * would resume an interrupted re-sign'
      else
        verify(release)
        puts ' * would re-sign'
      end
      puts ' * would push the re-signed tag and files'
    else
      if signed?(release, draft)
        puts ' * resuming an interrupted re-sign'
        FileUtils.cp(Dir[File.join(signed_dir(release), '*')], release.dir)
      else
        verify(release)
        sign(release, draft)
      end
      push_signed(release)
    end
  end

  def view(tag)
    JSON.parse(capture(@env, 'gh', 'release', 'view', tag, '--repo', @repository, '--json', 'id,isDraft,body'))
  end

  # Kept until the release is published, so an interrupted push or upload can be repeated.
  def signed_dir(release) = File.join(ROOT, 'tmp', 'publish', "#{release.tag.tr('/', '_')}.signed")

  # The release ID ties the signed files to this draft, not an earlier one with the same tag.
  def signed?(release, draft)
    File.read(File.join(signed_dir(release), '.complete')) == draft.fetch('id')
  rescue Errno::ENOENT
    false
  end

  def download(tag)
    dir = File.join(ROOT, 'tmp', 'publish', tag.tr('/', '_'))
    FileUtils.mkdir_p(dir)
    digests = JSON.parse(capture(@env, 'gh', 'release', 'view', tag, '--repo', @repository, '--json', 'assets'))
      .fetch('assets').to_h { [it.fetch('name'), it.fetch('digest')] }
    # A rebuilt draft keeps the asset names, so a file is reused only if it matches the asset's digest.
    Dir.children(dir).each do |name|
      path = File.join(dir, name)
      if File.file?(path) && digests[asset_name(name)] == "sha256:#{Digest::SHA256.file(path).hexdigest}"
        File.rename(path, File.join(dir, asset_name(name)))
      else
        FileUtils.rm_rf(path)
      end
    end
    run(@env, 'gh', 'release', 'download', tag, '--repo', @repository, '--dir', dir, '--skip-existing')
    restore_asset_names(dir)

    files = Dir[File.join(dir, '*')].sort
    changes_paths = files.grep(/\.changes\z/)
    dsc_paths = files.grep(/\.dsc\z/)
    raise "#{tag}: expected one .dsc, got #{dsc_paths.size}" unless dsc_paths.size == 1

    fields = parse_debian_metafile(File.read(changes_paths.first))
    Release.new(
      repository: @repository, prefix: @prefix, tag:, dir:, git_dir: @git_dir, changes_paths:, dsc_path: dsc_paths.first, files:,
      source: fields.fetch('Source').first, version: fields.fetch('Version').first, distro: fields.fetch('Distribution').first,
    )
  end

  def verify(release)
    puts ' * verifying what CI produced'
    git = ['git', '--git-dir', release.git_dir]
    run(*git, 'fetch', '-q', '--filter=blob:none', '--no-tags', '--force', @url,
      "refs/tags/#{release.tag}:refs/tags/#{release.tag}",
      "refs/heads/#{release.dist_branch}:refs/remotes/origin/#{release.dist_branch}")
    run('gitsign', 'verify-tag',
      "--certificate-identity=https://github.com/#{signer_workflow('_distro.yml')}@refs/heads/main",
      "--certificate-oidc-issuer=#{OIDC_ISSUER}", release.tag, chdir: File.dirname(release.git_dir))
    run(*git, 'merge-base', '--is-ancestor', "#{release.tag}^{commit}", "refs/remotes/origin/#{release.dist_branch}")

    each_parallel(release.files, ATTESTATION_JOBS) do |file|
      workflow = file.end_with?('.orig.tar.gz') ? 'build.yml' : '_distro.yml'
      ok = system(@env, 'gh', 'attestation', 'verify', file, '--repo', BUILD_REPOSITORY,
        '--signer-workflow', signer_workflow(workflow), '--source-ref', 'refs/heads/main', out: File::NULL)
      raise "#{File.basename(file)}: attestation verification failed" unless ok
      puts "  attested: #{File.basename(file)}"
    end

    [*release.changes_paths, release.dsc_path].each do |meta|
      parse_debian_metafile(File.read(meta)).fetch('Checksums-Sha256').each do |line|
        sha256, _size, name = line.split
        actual = Digest::SHA256.file(File.join(release.dir, name)).hexdigest
        raise "#{name}: sha256 #{actual} does not match #{File.basename(meta)}" unless actual == sha256
      end
    end
  end

  def sign(release, draft)
    puts " * re-signing with #{@fingerprint}"
    git = ['git', '--git-dir', release.git_dir]
    commit = capture(*git, 'rev-parse', "#{release.tag}^{commit}").strip
    run(*git, '-c', 'gpg.format=openpgp', 'tag', '-s', '-f', '-m', release.message, release.tag, commit)
    # sorah-debsign may run debsign in a container that only sees the working directory.
    run('sorah-debsign', *release.changes_paths.map { File.basename(it) }, chdir: release.dir)

    dir = signed_dir(release)
    FileUtils.rm_rf(dir)
    FileUtils.mkdir_p(dir)
    FileUtils.cp(release.signed_files, dir)
    File.write(File.join(dir, '.complete'), draft.fetch('id'))
  end

  # Repeatable: the tag is force-pushed and the files replaced, both with what sign produced.
  def push_signed(release)
    puts ' * pushing the re-signed tag and files'
    draft = view(release.tag)
    raise "#{release.tag} is no longer a draft" unless draft.fetch('isDraft')
    attestations = attestation_section(draft.fetch('body'))

    git = ['git', '--git-dir', release.git_dir]
    puts "  $ git push --force #{@url} refs/tags/#{release.tag}"
    auth = "http.https://github.com/.extraheader=AUTHORIZATION: basic #{["x-access-token:#{@token}"].pack('m0')}"
    system(*git, '-c', auth, 'push', '--force', @url, "refs/tags/#{release.tag}", exception: true)
    # Uploaded under the names GitHub gave them, so --clobber finds the assets to replace.
    upload_dir = File.join(release.dir, '.upload')
    FileUtils.mkdir_p(upload_dir)
    uploads = release.signed_files.map do |file|
      File.join(upload_dir, asset_name(file)).tap { FileUtils.cp(file, it) }
    end
    run(@env, 'gh', 'release', 'upload', release.tag, '--repo', @repository, '--clobber', *uploads)

    notes = File.join(release.dir, '.notes')
    File.write(notes, release_body(changes_by_arch: release.changes_by_arch, dsc: release.dsc, attestations:, resigned_by: @fingerprint))
    run(@env, 'gh', 'release', 'edit', release.tag, '--repo', @repository, '--notes-file', notes)
  end

  # Releases leave draft only after every distro is published, as that makes them immutable.
  def publish(releases)
    puts '=> publishing'
    distros = releases.map(&:distro).uniq
    if @dry_run
      releases.each { puts " * would add #{it.tag} to #{APTLY_REPO_PREFIX}-#{it.distro}" }
      distros.each { puts " * would publish #{it}" }
      distros.flat_map { index_urls(it) }.each { puts " * would purge #{it}" }
      releases.each { puts " * would release #{it.tag}" }
      return
    end

    releases.each do |release|
      check_signed(release)
      run('aptly', 'repo', 'add', "#{APTLY_REPO_PREFIX}-#{release.distro}", *release.aptly_files)
    end
    distros.each do |distro|
      run('aptly', 'publish', 'update', "-gpg-key=#{APTLY_GPG_KEY}", distro, APTLY_ENDPOINT)
    end
    purge(distros.flat_map { index_urls(it) })
    releases.each do |release|
      run(@env, 'gh', 'release', 'edit', release.tag, '--repo', @repository, '--draft=false')
    end
  end

  # cache.ruby-lang.org keeps serving the previous index until it is purged.
  def purge(urls)
    headers = {'x-purge-token' => ENV['RB_PURGE_TOKEN'], 'user-agent' => 'sorah-rbpkg-build-publish'}
    urls.zip(HTTPX.request('PURGE', urls, headers:)).each do |url, resp|
      raise "PURGE #{url}: #{resp.error.message}" if resp.error
      raise "PURGE #{url}: HTTP #{resp.status}" unless (200..299).cover?(resp.status)
      puts "  purged #{url}"
    end
  end

  def check_signed(release)
    run('git', '--git-dir', release.git_dir, 'fetch', '-q', '--filter=blob:none', '--no-tags', '--force', @url,
      "refs/tags/#{release.tag}:refs/tags/#{release.tag}")
    _, status_output, _ = Open3.capture3('git', '--git-dir', release.git_dir, 'verify-tag', '--raw', release.tag)
    raise "#{release.tag} is not signed by #{@fingerprint}" unless valid_signers(status_output).include?(@fingerprint)

    release.signed_files.each do |file|
      _, status_output, _ = Open3.capture3('gpg', '--status-fd', '2', '--verify', file)
      raise "#{File.basename(file)} is not signed by #{@fingerprint}" unless valid_signers(status_output).include?(@fingerprint)
    end
  end
end

# Pins the newest released version of each series and distro in versions.json of sorah-rbpkg/dockerfiles.
class DockerfilesRelay
  BRANCH = 'master'

  def initialize(dir:, repository:, token:, dry_run:)
    @dir = dir
    @repository = repository
    @dry_run = dry_run
    @env = {'GH_TOKEN' => token}
    @path = File.join(dir, 'versions.json')
  end

  # Runs before anything is published, so a checkout that cannot take the commits fails early.
  def check
    abort "#{@dir} has no versions.json; pass --dockerfiles-dir" unless File.exist?(@path)
    abort "#{@dir} has uncommitted changes" unless git('status', '--porcelain', '--untracked-files=no').empty?
    abort "#{@dir} is not on #{BRANCH}" unless git('branch', '--show-current').strip == BRANCH
    run('git', 'fetch', '-q', 'origin', BRANCH, chdir: @dir)
    abort "#{@dir}: #{BRANCH} is not at origin/#{BRANCH}" unless git('rev-parse', BRANCH) == git('rev-parse', "origin/#{BRANCH}")
  end

  def sync
    puts '=> relaying to dockerfiles'
    versions = JSON.parse(File.read(@path))
    tracked = versions.flat_map { |series, distros| distros.keys.map { [series, it] } } | built_pairs
    released = released_versions
    changes = tracked.sort.filter_map do |series, distro|
      version = released[[series, distro]] or next
      current = versions.dig(series, distro)
      [series, distro, version] if current.nil? || newer?(version, current)
    end
    if changes.empty?
      puts ' * versions.json is up to date'
      return
    end

    changes.group_by { |series, distro, version| [series, version.delete_suffix("~#{distro}")] }.each do |(series, version), entries|
      subject = "roll ruby#{series} #{version}"
      distros = entries.map { it[1] }
      if @dry_run
        puts " * would commit #{subject} for #{distros.join(', ')}"
        next
      end
      entries.each { |_, distro, deb_version| (versions[series] ||= {})[distro] = deb_version }
      File.write(@path, "#{JSON.pretty_generate(versions.sort.to_h { |s, ds| [s, ds.sort.to_h] })}\n")
      run('git', 'commit', '-q', '-m', subject, '-m', "Released for #{distros.join(', ')}.", '--', 'versions.json', chdir: @dir)
    end
    # Without --force, so a concurrent push fails rather than being overwritten.
    run('git', 'push', 'origin', BRANCH, chdir: @dir) unless @dry_run
  end

  private

  def git(*args) = capture('git', *args, chdir: @dir)

  def built_pairs
    Dir[File.join(ROOT, 'gen', 'builds', '*.json')].flat_map do |file|
      build = JSON.parse(File.read(file))
      build.fetch('distros').map { [build.fetch('source').delete_prefix('ruby'), it] }
    end
  end

  # Keyed by [series, distro], from the debian/<version>_<distro> tags of published releases.
  def released_versions
    tags = JSON.parse(capture(@env, 'gh', 'release', 'list', '--repo', @repository, '--limit', '1000', '--json', 'tagName,isDraft'))
      .reject { it.fetch('isDraft') }.map { it.fetch('tagName') }.grep(%r{\Adebian/})
    versions = tags.map { it.delete_prefix('debian/').gsub('.#', '.').tr('_%', '~:') }
    pairs = versions.filter_map do |version|
      series = version[/\A(\d+\.\d+)\./, 1]
      distro = version[/~([a-z]+)\z/, 1]
      [[series, distro], version] if series && distro
    end
    pairs.group_by(&:first).transform_values { |vs| vs.map(&:last).reduce { |a, b| newer?(b, a) ? b : a } }
  end

  def newer?(a, b) = system('dpkg', '--compare-versions', a, 'gt', b)
end

publish = true
dry_run = false
relay_only = false
dockerfiles_dir = File.expand_path('../dockerfiles', ROOT)
repository = 'sorah-rbpkg/ruby'
prefix = ''
test = false
OptionParser.new do |o|
  o.on('-n', '--dry-run', 'Only verify, without signing, pushing or publishing') { dry_run = true }
  o.on('--no-publish', 'Stop after re-signing') { publish = false }
  o.on('--repository OWNER/REPO') { repository = it }
  o.on('--dockerfiles-dir DIR', 'Local checkout of sorah-rbpkg/dockerfiles') { dockerfiles_dir = File.expand_path(it) }
  o.on('--relay-only', 'Only relay released versions to sorah-rbpkg/dockerfiles') { relay_only = true }
  o.on('--test', 'Work on the test/ releases of a test run, and never publish') do
    repository = BUILD_REPOSITORY
    prefix = 'test/'
    publish = false
    test = true
  end
end.parse!(ARGV)

# Runs share tmp/publish, and each prunes a draft's directory before downloading into it.
FileUtils.mkdir_p(File.join(ROOT, 'tmp', 'publish'))
lock = File.open(File.join(ROOT, 'tmp', 'publish', '.lock'), File::RDWR | File::CREAT)
abort 'another bin/publish is running' unless lock.flock(File::LOCK_EX | File::LOCK_NB)

# The DebReleaser token cannot see this repository's drafts, so a test uses your own gh login.
token = test ? ENV['GH_TOKEN'] || capture('gh', 'auth', 'token').strip : github_token
relay = DockerfilesRelay.new(dir: dockerfiles_dir, repository:, token:, dry_run:) if publish
if relay_only
  abort '--relay-only cannot be combined with --test or --no-publish' unless relay
  relay.check
  relay.sync
else
  Publisher.new(repository:, prefix:, tags: ARGV, publish:, dry_run:, token:, relay:).run_all
end
