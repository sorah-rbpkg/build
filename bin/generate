#!/bin/bash
# Usage: bin/generate [--check]
# Renders builds/*.jsonnet into gen/builds/*.json. --check fails when a rendered file differs.
set -euo pipefail
cd "$(dirname "$0")/.."

check=
if [[ "${1:-}" == "--check" ]]; then
  check=1
fi

status=0
for src in builds/*.jsonnet; do
  dst="gen/builds/$(basename "$src" .jsonnet).json"
  rendered="$(jrsonnet "$src")"
  if [[ -n "$check" ]]; then
    if ! diff -u "$dst" - <<<"$rendered"; then
      echo "$dst is out of date; run bin/generate" >&2
      status=1
    fi
  else
    printf '%s\n' "$rendered" > "$dst"
  fi
done
exit "$status"
