#!/usr/bin/env ruby
# Usage: bin/verify-orig [--master [--trusted FILE] | --upstream TARBALL] ORIG_TARBALL UPSTREAM_VERSION
#
# Checks that an orig tarball holds the same files as the ruby-lang.org release of UPSTREAM_VERSION, whose tarball
# is checked against checksums/ruby-<version>.json, or against master's releases.yml for a version without one.
#
# --master checks against master's releases.yml, and that checksums/ agrees with it, unless the trusted-checksums.txt
# FILE given with --trusted lists the committed checksum.
# --upstream compares against a release tarball the caller has already checked instead.
require 'digest'
require 'find'
require 'optparse'
require 'tmpdir'
require_relative '../lib/ruby_release'

# Directories are left out, because git cannot keep an empty one.
def manifest(tarball, dir)
  Dir.mkdir(dir)
  system('tar', '-xzf', tarball, '-C', dir, exception: true)
  roots = Dir.children(dir)
  raise "#{tarball}: expected one top-level directory, got #{roots.join(', ')}" unless roots.size == 1

  root = File.join(dir, roots.fetch(0))
  Find.find(root).filter_map do |path|
    stat = File.lstat(path)
    name = path.delete_prefix("#{root}/")
    if stat.symlink?
      [name, 'symlink', File.readlink(path)]
    elsif stat.file?
      [name, format('%o', stat.mode & 0o777), Digest::SHA256.file(path).hexdigest]
    end
  end.sort
end

upstream = nil
master = false
trusted = nil
OptionParser.new do |o|
  o.on('--master', "Check against master's releases.yml, and that checksums/ agrees with it") { master = true }
  o.on('--trusted FILE', 'Checksums trusted without master, as in trusted-checksums.txt') { trusted = it }
  o.on('--upstream TARBALL', 'Release tarball already checked against its sha256') { upstream = File.expand_path(it) }
end.parse!(ARGV)
orig, upstream_version = ARGV
abort 'Usage: bin/verify-orig [--master [--trusted FILE] | --upstream TARBALL] ORIG_TARBALL UPSTREAM_VERSION' unless orig && upstream_version
abort '--trusted needs --master' if trusted && !master
abort '--master and --upstream do not mix' if master && upstream

Dir.mktmpdir('verify-orig') do |tmp|
  if upstream
    url = upstream
  else
    version = upstream_version.tr('~', '-')
    committed = RubyRelease::Checksum.read(version)
    trusted_lines = trusted ? File.readlines(trusted, chomp: true).map { it.sub(/#.*/, '').strip } : []
    if master && committed && trusted_lines.include?("#{version} #{committed.sha256}")
      warn "#{trusted} lists #{version} #{committed.sha256}, so master's releases.yml is not consulted"
      master = false
    end
    checksum = master || !committed ? RubyRelease::Index.load.find(version) : committed
    if master && committed && committed.sha256 != checksum.sha256
      abort "#{committed.path} has sha256 #{committed.sha256} from #{committed.source}, but #{checksum.source} has #{checksum.sha256}"
    end

    upstream = File.join(tmp, File.basename(checksum.url))
    url = RubyRelease.download(checksum, upstream)
  end

  expected = manifest(upstream, File.join(tmp, 'upstream'))
  got = manifest(orig, File.join(tmp, 'orig'))
  if expected != got
    (expected - got).first(20).each { warn "- #{it.join(' ')}" }
    (got - expected).first(20).each { warn "+ #{it.join(' ')}" }
    abort "#{orig} differs from #{url}"
  end
  puts "#{orig} matches #{url} (#{expected.size} files)"
end
