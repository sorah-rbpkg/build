#!/usr/bin/env ruby
# Usage: bin/roll [--repository OWNER/REPO] [--source-dir DIR] [--series ID] REV...
#
# Points each series at REV of the source repository, a branch name or a full SHA, and commits each one.
# The series is the one for the source package named by debian/changelog at REV. When several series share
# that source, as ruby-defaults does, it is the one built from branch REV, or the one given with --series. Every series is checked with bin/plan
# before anything is committed. Pushing the commits starts the builds.
#
# A local checkout of the source repository, ../<repo> by default, must have pushed REV's branch and, unless
# it is a native package, its upstream tag, as REV is resolved on GitHub.
require 'fileutils'
require 'json'
require 'open3'
require 'optparse'

ROOT = File.expand_path('..', __dir__)

Roll = Data.define(:rev, :commit, :source, :version, :upstream_tag, :id) do
  def src = File.join('builds', "#{id}.jsonnet")
  def json = File.join('gen', 'builds', "#{id}.json")
end

def run(*cmd, **opts) = system(*cmd, exception: true, chdir: ROOT, **opts)

def capture(*cmd)
  out, status = Open3.capture2(*cmd, chdir: ROOT)
  raise "#{cmd.join(' ')} failed" unless status.success?
  out
end

repository = 'sorah-rbpkg/ruby'
source_dir = nil
series_id = nil
OptionParser.new do |o|
  o.on('--repository OWNER/REPO') { repository = it }
  o.on('--source-dir DIR', 'Local checkout of the source repository') { source_dir = File.expand_path(it) }
  o.on('--series ID', 'Series under builds/, when REV alone does not tell') { series_id = it }
end.parse!(ARGV)
abort 'Usage: bin/roll [--repository OWNER/REPO] [--source-dir DIR] [--series ID] REV...' if ARGV.empty?
abort '--series takes a single REV' if series_id && ARGV.size > 1
source_dir ||= File.expand_path(File.join('..', repository.split('/').last), ROOT)
abort "#{source_dir} is not a checkout of #{repository}; pass --source-dir" unless File.directory?(File.join(source_dir, '.git'))

branch = capture('git', 'branch', '--show-current').strip
abort "on #{branch.empty? ? 'a detached HEAD' : branch}, not main" unless branch == 'main'

url = "https://github.com/#{repository}.git"
# Shared with bin/plan.
dir = File.join(ROOT, 'tmp', 'plan', repository.tr('/', '_'))
capture('git', 'init', '-q', '--bare', dir) unless File.directory?(dir)

builds = Dir[File.join(ROOT, 'gen', 'builds', '*.json')].to_h { [File.basename(it, '.json'), JSON.parse(File.read(it))] }

def find_series(builds, repository:, source:, rev:, series_id:)
  return series_id if series_id

  candidates = builds.select { |_, b| b.fetch('repository') == repository && b.fetch('source') == source }
  candidates = candidates.select { |_, b| b.fetch('master') == rev } if candidates.size > 1
  abort "#{rev}: no series under builds/ builds #{source} from #{repository}" if candidates.empty?
  abort "#{rev}: several series build #{source}; pass --series" if candidates.size > 1
  candidates.keys.first
end

rolls = ARGV.map do |rev|
  commit = if rev.match?(/\A\h{40}\z/)
    rev
  else
    capture('git', 'ls-remote', url, "refs/heads/#{rev}").split("\t").first or abort "#{rev} is not a branch of #{repository}"
  end
  capture('git', '-C', dir, 'fetch', '-q', '--filter=blob:none', '--no-tags', url, commit)
  head = capture('git', '-C', dir, 'cat-file', 'blob', "#{commit}:debian/changelog").lines.first
  m = head.match(/\A(?<source>\S+) \((?<version>[^)]+)\)/) or abort "#{rev}: cannot parse changelog: #{head}"
  # A native package, without a Debian revision, has no upstream tag.
  upstream_tag = if m[:version].sub(/\A\d+:/, '').include?('-')
    "upstream/#{m[:version].sub(/\A\d+:/, '').sub(/-[^-]+\z/, '').tr('~:', '_%')}"
  end
  Roll.new(rev:, commit:, source: m[:source], version: m[:version].sub('~dist', ''), upstream_tag:,
    id: find_series(builds, repository:, source: m[:source], rev:, series_id:))
end

def local_rev(dir, ref)
  out, status = Open3.capture2('git', '-C', dir, 'rev-parse', '--verify', '-q', ref)
  status.success? ? out.strip : nil
end

rolls.each do |roll|
  unless roll.rev.match?(/\A\h{40}\z/)
    local = local_rev(source_dir, "refs/heads/#{roll.rev}")
    abort "#{roll.rev} is at #{local} in #{source_dir} but at #{roll.commit} on #{repository}" if local && local != roll.commit
  end
  next unless roll.upstream_tag

  remote = capture('git', 'ls-remote', url, "refs/tags/#{roll.upstream_tag}").split("\t").first
  abort "#{roll.upstream_tag} is not on #{repository}; push it first" unless remote
  local = local_rev(source_dir, "refs/tags/#{roll.upstream_tag}")
  abort "#{roll.upstream_tag} differs between #{source_dir} and #{repository}" if local && local != remote
end

rolls.group_by(&:id).each do |id, group|
  abort "#{group.map(&:rev).join(', ')} are all #{id}" if group.size > 1
end
rolls.each do |roll|
  abort "#{roll.rev} is #{roll.id}, which has no #{roll.src}" unless File.exist?(File.join(ROOT, roll.src))
  abort "#{roll.src} or #{roll.json} has uncommitted changes" unless capture('git', 'status', '--porcelain', '--', roll.src, roll.json).empty?
end

rolls = rolls.reject do |roll|
  current = JSON.parse(File.read(File.join(ROOT, roll.json))).fetch('commit')
  next false unless current == roll.commit

  warn "#{roll.source} is already at #{roll.commit}, skipping"
  true
end
exit if rolls.empty?

plans = begin
  rolls.each do |roll|
    path = File.join(ROOT, roll.src)
    current = JSON.parse(File.read(File.join(ROOT, roll.json))).fetch('commit')
    text = File.read(path)
    raise "#{roll.src} does not mention #{current} exactly once" unless text.scan(current).size == 1
    File.write(path, text.sub(current, roll.commit))
  end
  run('bin/generate')
  rolls.to_h { [it, JSON.parse(capture('bin/plan', it.json)).fetch('targets')] }
rescue
  run('git', 'checkout', '--', *rolls.flat_map { [it.src, it.json] })
  raise
end

message = File.join(ROOT, 'tmp', 'roll-message')
FileUtils.mkdir_p(File.dirname(message))
plans.each do |roll, targets|
  test = JSON.parse(File.read(File.join(ROOT, roll.json))).fetch('test')
  summary = if targets.empty?
    'Every distro is already released, so nothing is built.'
  else
    "Builds #{targets.map { it.fetch('distro') }.join(', ')}#{test ? ' in test mode' : ''}."
  end
  File.write(message, ["roll #{roll.source} #{roll.version}", '', "#{repository}@#{roll.commit}", '', summary].join("\n"))
  run('git', 'add', '--', roll.src, roll.json)
  run('git', 'commit', '-q', '-F', message)
  run('git', '--no-pager', 'show', '--format=%h %s%n%n%b')
end
