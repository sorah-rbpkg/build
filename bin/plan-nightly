#!/usr/bin/env ruby
# Usage: bin/plan-nightly [--force] [--out DIR] [gen/builds/rubyN.M.json ...]
#
# Prints the nightly targets as JSON: {"targets": [...], "origs": [...]}, one target per series, distro and arch.
# Each rubyN.M series builds the cache.ruby-lang.org snapshot of ruby_N_M, saved to DIR as its orig tarball.
# A series whose snapshot revision every distro of sorah-rbpkg/dockerfiles' nightly.json already has is left out
# unless --force.
require 'digest'
require 'fileutils'
require 'net/http'
require 'optparse'
require_relative '../lib/plan'

SNAPSHOT_BASE = 'https://cache.ruby-lang.org/pub/ruby/snapshot'
NIGHTLY_JSON_URL = 'https://raw.githubusercontent.com/sorah-rbpkg/dockerfiles/master/nightly.json'
# Below the 0nkmi1 of a release of the same upstream version.
DEBIAN_REVISION = '0nkmi0'

def http_get(url)
  res = Net::HTTP.get_response(URI(url))
  return nil if res.is_a?(Net::HTTPNotFound)
  raise "GET #{url}: #{res.code}" unless res.is_a?(Net::HTTPSuccess)
  res.body
end

def define(header, name)
  header[/^\s*#\s*define\s+#{name}\s+(.+?)\s*$/, 1] or raise "no #{name}"
end

# <X.Y.Z>+git<YYYYMMDD>.g<hash>, or ~git while the branch is before its first release (patchlevel -1).
def upstream_version(series_version, version_h, revision_h)
  teeny = Integer(define(version_h, 'RUBY_VERSION_TEENY'))
  patchlevel = Integer(define(version_h, 'RUBY_PATCHLEVEL'))
  date = %w[YEAR MONTH DAY].map { Integer(define(revision_h, "RUBY_RELEASE_#{it}")) }
  revision = define(revision_h, 'RUBY_FULL_REVISION').delete('"')
  raise "unexpected revision #{revision}" unless revision.match?(/\A\h{40}\z/)

  sep = patchlevel == -1 ? '~' : '+'
  version = format('%s.%d%sgit%04d%02d%02d.g%s', series_version, teeny, sep, *date, revision[0, 10])
  [version, revision]
end

# Downloads the snapshot of the series' branch into out, checked against the sha256 snapshot-*.json lists.
def fetch_snapshot(branch, out:)
  meta = JSON.parse(http_get("#{SNAPSHOT_BASE}/snapshot-#{branch}.json") || raise("no snapshot of #{branch}")).fetch(0)
  sha256 = meta.fetch('sha256').fetch('gz')
  path = File.join(out, "snapshot-#{branch}.tar.gz")
  body = http_get("#{SNAPSHOT_BASE}/snapshot-#{branch}.tar.gz") || raise("no snapshot-#{branch}.tar.gz")
  raise "snapshot-#{branch}.tar.gz does not match its sha256 #{sha256}; retry once the snapshot is updated" unless Digest::SHA256.hexdigest(body) == sha256
  File.binwrite(path, body)
  [path, sha256]
end

def read_from_tarball(path, file)
  out, status = Open3.capture2('tar', '-xzOf', path, '--wildcards', "*/#{file}")
  raise "#{path}: no #{file}" unless status.success? && !out.empty?
  out
end

def plan_series(series, out:, force:, nightly:)
  # A proposed series is a preview, which has no snapshot branch yet.
  if series.proposed
    warn "#{series.id}: proposed, skipping"
    return []
  end
  m = series.source.match(/\Aruby(\d+\.\d+)\z/) or raise "#{series.file}: #{series.source} is not a Ruby series"
  series_version = m[1]
  branch = "ruby_#{series_version.tr('.', '_')}"

  snapshot, sha256 = fetch_snapshot(branch, out:)
  version_h = read_from_tarball(snapshot, 'version.h')
  api = %w[MAJOR MINOR].map { define(read_from_tarball(snapshot, 'include/ruby/version.h'), "RUBY_API_VERSION_#{it}") }.join('.')
  raise "#{branch} snapshot is Ruby #{api}, not #{series_version}" unless api == series_version
  upstream_version, revision = upstream_version(series_version, version_h, read_from_tarball(snapshot, 'revision.h'))

  if !force && series.distros.all? { nightly.dig(series_version, it, 'revision') == revision }
    warn "#{series.id}: #{branch} is still at #{revision}, skipping"
    File.delete(snapshot)
    return []
  end

  orig_name = "#{series.source}_#{upstream_version}.orig.tar.gz"
  File.rename(snapshot, File.join(out, orig_name))

  # Each distro builds the packaging of its last release, which may carry changes for that distro alone.
  dist_heads = git('ls-remote', '--heads', series.url, "refs/heads/#{series.dist}/*")
    .lines(chomp: true).to_h { it.split("\t", 2).reverse }

  series.distros.flat_map do |distro|
    packaging_commit = dist_heads.fetch("refs/heads/#{series.dist}/#{distro}", series.commit)
    series.archs.map.with_index do |arch, i|
      {
        id: series.id,
        source: series.source,
        repository: series.repository,
        series: series_version,
        branch:,
        distro:,
        arch:,
        # The first arch also builds the source package and arch:all packages.
        build: i.zero? ? 'full' : 'any',
        runner: runner_for(arch, large: false),
        packaging_commit:,
        upstream_version:,
        revision:,
        changelog_version: "#{upstream_version}-#{DEBIAN_REVISION}~dist",
        deb_version: "#{upstream_version}-#{DEBIAN_REVISION}~#{distro}",
        orig_name:,
        orig_sha256: sha256,
        image: image_for(distro),
        dockerfile: series.dockerfile(distro),
        smoke: series.smoke,
        artifact: "nightly-#{series.id}-#{distro}-#{arch}",
      }
    end
  end
end

force = false
out = File.join(ROOT, 'tmp', 'nightly')
OptionParser.new do |o|
  o.on('--force', 'Build series whose snapshot revision is already in nightly.json') { force = true }
  o.on('--out DIR', 'Directory to save orig tarballs in') { out = it }
end.parse!(ARGV)
FileUtils.mkdir_p(out)

files = ARGV.empty? ? Dir[File.join(ROOT, 'gen/builds/ruby[0-9]*.json')] : ARGV.map { File.expand_path(it) }
nightly = JSON.parse(http_get(NIGHTLY_JSON_URL) || '{}')
targets = files.sort.flat_map { plan_series(Series.load(it), out:, force:, nightly:) }
origs = targets.map { it.slice(:id, :series, :branch, :upstream_version, :revision, :orig_name, :orig_sha256) }.uniq

puts JSON.generate({targets:, origs:})
